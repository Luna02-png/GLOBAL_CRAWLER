# Copy to .env and edit. Never commit real secrets.
GPTI_HOST=127.0.0.1
GPTI_PORT=8765
GPTI_TIMEZONE=Asia/Ho_Chi_Minh
# Where the SQLite database lives (default: ./data). For PostgreSQL use e.g.
# GPTI_DATABASE_URL=postgresql+psycopg://user:pass@localhost/gpti   (pip install "psycopg[binary]")
# GPTI_DATA_DIR=C:\GPTI\data
GPTI_ENABLE_SCHEDULER=1
GPTI_ENABLE_WORKER=1
GPTI_GLOBAL_CONCURRENCY=4
GPTI_HTTP_TIMEOUT=20
GPTI_CACHE_TTL_SECONDS=1800
GPTI_MAX_RESULTS_PER_TASK=100
# Optional official APIs (free quota). Leave empty -> source shows NOT_CONFIGURED.
YOUTUBE_API_KEY=
